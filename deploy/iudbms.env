# /etc/iudbms/iudbms.env -- read by both iudbms-monitor.service and
# iudbms-api.service. Restart both after editing:
#   sudo systemctl restart iudbms-monitor iudbms-api

# Where everything lives. Both units must agree on these.
IUDBMS_DB=/var/lib/iudbms/iudbms.db
IUDBMS_MODELS=/var/lib/iudbms/models

# --- monitor ---------------------------------------------------------------
# Raw URB trace payloads:
#   pseudonymous  keyed permutation, key never stored; every feature can still
#                 be recomputed exactly. NOT anonymous: a long typing session is
#                 a substitution cipher and open to frequency analysis.
#   none          no payloads; three payload features cannot be recomputed
#   full          raw bytes, i.e. every keystroke in clear. Consented, owned
#                 devices only.
#   off           no raw trace at all (features and scores are still stored)
IUDBMS_TRACE=pseudonymous
# Retention cap on stored URBs. Each alert's evidence window is exempt.
IUDBMS_TRACE_MAX_EVENTS=1000000
# actions: escalations plus a heartbeat every 60 windows. verbose: every
# device every second, which floods the journal on a busy host.
IUDBMS_LOG=actions
# Anything else the monitor takes, e.g. "--bus 1" to watch one bus only.
IUDBMS_MONITOR_ARGS=--bus 0

# --- API -------------------------------------------------------------------
IUDBMS_API_HOST=127.0.0.1
IUDBMS_API_PORT=8000
# Comma-separated origins allowed cross-origin. Leave unset: the dashboard is
# served by the API itself and needs none.
#IUDBMS_CORS_ORIGINS=

# --- safety ----------------------------------------------------------------
# Suppresses every escalation in the policy engine. Takes effect on restart.
#IUDBMS_KILL_SWITCH=1
