# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated artefacts (regenerate with `make eval`)
out/*.db
out/*.db-wal
out/*.db-shm
artifacts/
*.pt
*.pth
# ...except the deployed LSTM. The blanket rule above excluded it while the
# 9.6 MB Stage-1 model beside it was tracked, so every fresh clone had an
# incomplete model set -- and the monitor then ran Stage 1 alone, silently.
!out/models/stage2.pt

# Node / dashboard
node_modules/
dashboard/dist/

# OS
.DS_Store

# Regenerable, 2.6 MB, and tied to both CONTRACT_VERSION and the simulator
# fingerprint -- load_corpus refuses a mismatched one anyway (finding 16). A
# tracked copy is a stale binary waiting to be loaded, which is how `make eval`
# came to report numbers from a corpus a third of the intended size.
out/corpus_cache.npz

# Analysis-experiment checkpoints (eval/analysis_retrain.py); never the deployment's
out/analysis_models/
out/analysis_*.npz
out/analysis_*.cond.json

# Corpus-A models: regenerated by `make eval`; the deployed set is out/models/
out/models_corpus_a/

# Real-kernel testbed: third-party human-input datasets (research licences; fetched
# by `python3 -m testbed.human_input fetch`, never redistributed), distribution
# images, and raw guest captures (decodable keystrokes). Summaries are committed.
data/human/
testbed/images/
out/testbed/raw/
out/testbed/scores/
out/testbed/*.log
out/analysis_*.log
